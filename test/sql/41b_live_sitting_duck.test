       (SELECT count(*) FROM ((SELECT regexp_replace(file_path, '.*/', '') AS f, node_id FROM ast_select_from('sd_py_variety', '.class')) EXCEPT (SELECT DISTINCT regexp_replace(file_path, '.*/', '') AS f, node_id FROM tree_match('main', 'py_variety', '.class', language := 'css'))));

# name: test/sql/41b_live_sitting_duck.test
# description: duckent's match against the INSTALLED sitting_duck, on sitting_duck's
# own read_ast rows, read from ~/Projects/astcss-eval/fixtures. That checkout has to be
# there: the runner can skip a file for a missing extension, not for a missing directory.
#
# 76 of 108 rows run here. The other 32 are skipped for a reason the corpus records,
# not for convenience: 31 have a combinator in their chain, which the installed engine
# returns 0 rows for (sitting_duck #127 -- the frozen references in 41 were captured on
# a build that had it fixed, so 41 still holds them), and 1 adjudicated divergent.
#
# GENERATED by test/import_astcss_eval.py from test/corpus/selectors.tsv and
# ~/Projects/astcss-eval/pairs/accepted-b*.jsonl -- do not edit by hand.

require sitting_duck

statement ok
LOAD sitting_duck;

statement ok
CREATE TABLE sd_py_variety AS SELECT * REPLACE (regexp_replace(file_path, '.*/', '') AS file_path) FROM read_ast('~/Projects/astcss-eval/fixtures/py-variety/*.py');

statement ok
CREATE TABLE sd_scripts AS SELECT * REPLACE (regexp_replace(file_path, '.*/', '') AS file_path) FROM read_ast('~/Projects/astcss-eval/fixtures/repo-small-py/*.py');

# The corpus trees. CLASSES, ELEMENT and `params` are columns test/gen_fixtures.py
# derived from sitting_duck at fixture time, so nothing here needs the extension.

statement ok
CALL tree_ddl_create('main', 'scripts', tree_spec(tree_shape(
  root := 'file_path', "order" := 'node_id', level := 'depth', size := 'descendant_count',
  semantic := tree_semantic(type := 'type', id := 'name', classes := 'css_classes',
    element := 'is_element', pseudo := [{name: 'def', body: '(flags & 6) = 6'}])),
  source := 'read_parquet(''test/data/scripts.parquet'')'));

statement ok
CALL tree_ddl_create('main', 'py_variety', tree_spec(tree_shape(
  root := 'file_path', "order" := 'node_id', level := 'depth', size := 'descendant_count',
  semantic := tree_semantic(type := 'type', id := 'name', classes := 'css_classes',
    element := 'is_element', pseudo := [{name: 'def', body: '(flags & 6) = 6'}])),
  source := 'read_parquet(''test/data/py_variety.parquet'')'));


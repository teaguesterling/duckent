# name: test/sql/10_projection.test
# description: projection compiler emits canonical columns; derivations equal sitting_duck's native columns

# level basis, ORDER declared, no O declared: derived _parent and _size must equal native columns
query III
WITH p AS (FROM query(tree_compile_projection(tree_shape(root := 'file_path', "order" := 'node_id', level := 'depth'), 'read_parquet(''test/data/app.parquet'')', '*')))
SELECT count(*),
       count(*) FILTER (WHERE _parent IS DISTINCT FROM parent_id),
       count(*) FILTER (WHERE _size <> descendant_count)
FROM p;
----
54	0	0

# _children equals native children_count, _next is pre + size + 1, _type defaults to 'node'
query III
WITH p AS (FROM query(tree_compile_projection(tree_shape("order" := 'node_id', level := 'depth'), 'read_parquet(''test/data/app.parquet'')', '*')))
SELECT count(*) FILTER (WHERE _children <> children_count), count(*) FILTER (WHERE _next <> _pre + _size + 1), min(_type) FROM p;
----
0	0	node

# declared O columns are used verbatim; TYPE, ID, pseudo map compile
query IIII
WITH p AS (FROM query(tree_compile_projection(
  tree_shape(root := 'file_path', "order" := 'node_id', level := 'depth', parent := 'parent_id', size := 'descendant_count', children := 'children_count',
             semantic := tree_semantic(type := 'type', id := 'name', pseudo := [{name: 'leaf', body: 'descendant_count = 0'}])),
  'read_parquet(''test/data/app.parquet'')', 'name, start_line')))
SELECT _type, _id, _pseudo['leaf'], start_line FROM p WHERE _pre = 6;
----
function_definition	greet	false	4

# closed attribute list: no source columns survive
query I
WITH p AS (FROM query(tree_compile_projection(tree_shape("order" := 'node_id', level := 'depth'), 'read_parquet(''test/data/app.parquet'')', '')))
SELECT count(*) FROM (DESCRIBE FROM p) WHERE column_name NOT LIKE '\_%' ESCAPE '\';
----
0

# frozen order: no ORDER, pre derived from scan order within root
query II
WITH p AS (FROM query(tree_compile_projection(tree_shape(root := 'file_path', level := 'depth'), 'read_parquet(''test/data/app.parquet'')', '*')))
SELECT min(_pre), count(*) FILTER (WHERE _pre <> node_id) FROM p;
----
0	0

# an undeclared ATTR MAP is a typed NULL, not an untyped one (M8), and its type is the
# canonical map type: a declared one is cast to it, so the column type never depends on
# what the declaration happened to produce
query II
WITH p AS (FROM query(tree_compile_projection(tree_shape("order" := 'node_id', level := 'depth'), 'read_parquet(''test/data/app.parquet'')', '')))
SELECT column_name, column_type FROM (DESCRIBE FROM p) WHERE column_name = '_attr_map';
----
_attr_map	MAP(VARCHAR, VARCHAR)

# derived _parent and _size are scoped to the ROOT partition: the same check as the first
# query, over the multi-tree fixture where node_id and depth restart per file
query III
WITH p AS (FROM query(tree_compile_projection(tree_shape(root := 'file_path', "order" := 'node_id', level := 'depth'), 'read_parquet(''test/data/scripts.parquet'')', '*')))
SELECT count(*),
       count(*) FILTER (WHERE _parent IS DISTINCT FROM parent_id),
       count(*) FILTER (WHERE _size <> descendant_count)
FROM p;
----
14265	0	0

# parent basis: encoder yields pre-order by sibling key, level from depth of chain
query IIII
WITH p AS (FROM query(tree_compile_projection(tree_shape(key := 'email', parent := 'manager_email', sibling_order := 'hire_date',
             semantic := tree_semantic(type := 'role', id := 'email')), 'read_csv(''test/data/employees.csv'')', '*')))
SELECT _pre, _level, _id, _parent FROM p ORDER BY _pre LIMIT 4;
----
0	0	ada@co	NULL
1	1	cy@co	0
2	2	fay@co	1
3	3	gus@co	2

# parent basis sizes: cto has 6 descendants, bo has 2
query II
WITH p AS (FROM query(tree_compile_projection(tree_shape(key := 'email', parent := 'manager_email', sibling_order := 'hire_date'), 'read_csv(''test/data/employees.csv'')', '*')))
SELECT (SELECT _size FROM p WHERE email = 'ada@co'), (SELECT _size FROM p WHERE email = 'bo@co');
----
6	2

# ELEMENT is a per-row predicate (default true) and ATTR MAP is a typed MAP, not text
query III
WITH p AS (FROM query(tree_compile_projection(tree_shape("order" := 'node_id', level := 'depth',
  semantic := tree_semantic(element := 'regexp_matches(type, ''^[a-z_]'')', attr_map := 'MAP {''k'': CAST(node_id AS VARCHAR)}')),
  'read_parquet(''test/data/app.parquet'')', '*')))
SELECT count(*) FILTER (WHERE NOT _element), typeof(any_value(_attr_map)), any_value(_attr_map['k']) FROM p WHERE _pre = 6;
----
0	MAP(VARCHAR, VARCHAR)	6

# with no ELEMENT declared every row is an element
query I
WITH p AS (FROM query(tree_compile_projection(tree_shape("order" := 'node_id', level := 'depth'), 'read_parquet(''test/data/app.parquet'')', '*')))
SELECT count(*) FILTER (WHERE NOT _element) FROM p;
----
0

# _pre is the rank of ORDER within ROOT, so any strictly increasing ORDER gives the same tree:
# a gapped, offset ORDER and a declared PARENT/NEXT in that same ORDER space.
statement ok
CREATE TABLE gapped AS SELECT * REPLACE (node_id * 3 + 7 AS node_id,
  CASE WHEN parent_id IS NULL THEN NULL ELSE parent_id * 3 + 7 END AS parent_id) FROM 'test/data/app.parquet';

query IIII
WITH d AS (FROM query(tree_compile_projection(tree_shape(root := 'file_path', "order" := 'node_id', level := 'depth'), 'read_parquet(''test/data/app.parquet'')', '*'))),
     g AS (FROM query(tree_compile_projection(tree_shape(root := 'file_path', "order" := 'node_id', level := 'depth'), 'gapped', '*'))),
     gp AS (FROM query(tree_compile_projection(tree_shape(root := 'file_path', "order" := 'node_id', level := 'depth', parent := 'parent_id'), 'gapped', '*')))
SELECT (SELECT list(_pre ORDER BY _pre) FROM g) = (SELECT list(_pre ORDER BY _pre) FROM d),
       (SELECT min(_pre) FROM g),
       (SELECT count(*) FROM g JOIN d USING (_pre) WHERE g._parent IS DISTINCT FROM d._parent OR g._size IS DISTINCT FROM d._size),
       (SELECT count(*) FROM gp JOIN d USING (_pre) WHERE gp._parent IS DISTINCT FROM d._parent);
----
true	0	0	0

# ORDER need not be an integer: a VARCHAR ORDER that sorts as node_id does but cannot be cast
# to one (the 'n' prefix is what makes this a record about rank rather than about lpad, which
# zero-pads a number to a string that still casts).
query I
WITH d AS (FROM query(tree_compile_projection(tree_shape(root := 'file_path', "order" := 'node_id', level := 'depth'), 'read_parquet(''test/data/app.parquet'')', '*'))),
     s AS (FROM query(tree_compile_projection(tree_shape(root := 'file_path', "order" := '''n'' || lpad(node_id::VARCHAR, 4, ''0'')', level := 'depth'), 'read_parquet(''test/data/app.parquet'')', '*')))
SELECT count(*) FROM s JOIN d USING (_pre) WHERE s.node_id <> d.node_id;
----
0

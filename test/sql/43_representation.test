# name: test/sql/43_representation.test
# description: P23 -- a semantic is what it selects, not how it is spelled. TYPE as a
# column vs as an expression, a PSEUDO body vs the same predicate promoted to CLASSES,
# and ELEMENT as a column vs as a macro over the flag bit it was derived from.
#
# (a) and (c) run the `app` rows of test/corpus/selectors.tsv; (b) and the last record
# of (c) are selectors written for those two claims, which the corpus has no row for.
#
# GENERATED by test/import_astcss_eval.py from test/corpus/selectors.tsv and
# ~/Projects/astcss-eval/pairs/accepted-b*.jsonl -- do not edit by hand.

# --------------------------------------------------------------------------------------
# (a) TYPE: a column, or an expression over it
# --------------------------------------------------------------------------------------

statement ok
CALL tree_ddl_create('main', 'rep_col', tree_spec(tree_shape(
  root := 'file_path', "order" := 'node_id', level := 'depth',
  size := 'descendant_count',
  semantic := tree_semantic(type := 'type', id := 'name', classes := 'css_classes',
    element := 'is_element', pseudo := [{name: 'def', body: '(flags & 6) = 6'}])),
  source := 'read_parquet(''test/data/app.parquet'')'));

statement ok
CALL tree_ddl_create('main', 'rep_expr', tree_spec(tree_shape(
  root := 'file_path', "order" := 'node_id', level := 'depth',
  size := 'descendant_count',
  semantic := tree_semantic(type := 'lower(upper(type))', id := 'name', classes := 'css_classes',
    element := 'is_element', pseudo := [{name: 'def', body: '(flags & 6) = 6'}])),
  source := 'read_parquet(''test/data/app.parquet'')'));


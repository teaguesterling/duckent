# --------------------------------------------------------------------------------------
# (b) promotion: one predicate as a PSEUDO body, and as a CLASSES list the source computes
# --------------------------------------------------------------------------------------

statement ok
CALL tree_ddl_create('main', 'rep_pseudo', tree_spec(tree_shape(
  root := 'file_path', "order" := 'node_id', level := 'depth',
  size := 'descendant_count',
  semantic := tree_semantic(type := 'type', pseudo := [{name: 'def', body: '(flags & 6) = 6'}])),
  source := 'read_parquet(''test/data/app.parquet'')'));

statement ok
CALL tree_ddl_create('main', 'rep_class', tree_spec(tree_shape(
  root := 'file_path', "order" := 'node_id', level := 'depth',
  size := 'descendant_count',
  semantic := tree_semantic(type := 'type', classes := 'cls')),
  source := '(SELECT *, CASE WHEN (flags & 6) = 6 THEN [''def''] ELSE [] END AS cls FROM read_parquet(''test/data/app.parquet''))'));

# the bare pseudo-class
query I
SELECT (SELECT list(file_path || ':' || node_id ORDER BY file_path, node_id)
        FROM tree_match('main', 'rep_pseudo', tree_steps([{pseudo: 'def'}])))
     = (SELECT list(file_path || ':' || node_id ORDER BY file_path, node_id)
        FROM tree_match('main', 'rep_class', tree_steps([{class: 'def'}])));
----
true

# a compound that also constrains TYPE
query I
SELECT (SELECT list(file_path || ':' || node_id ORDER BY file_path, node_id)
        FROM tree_match('main', 'rep_pseudo', tree_steps([{type: 'function_definition', pseudo: 'def'}])))
     = (SELECT list(file_path || ':' || node_id ORDER BY file_path, node_id)
        FROM tree_match('main', 'rep_class', tree_steps([{type: 'function_definition', class: 'def'}])));
----
true

# The two records above say a promoted class and its pseudo-class select the same
# rows. They do NOT say a class may be ANSWERED from a pseudo-class body: promotion
# is something the tree's declaration does, not something the matcher may infer per
# row. rep_class_none binds `def` as a PSEUDO and declares an empty CLASSES list, so
# `.def` must select nothing there while `:def` still selects every def -- the second
# column, which keeps the first from passing on a tree that selects nothing at all.

statement ok
CALL tree_ddl_create('main', 'rep_class_none', tree_spec(tree_shape(
  root := 'file_path', "order" := 'node_id', level := 'depth',
  size := 'descendant_count',
  semantic := tree_semantic(type := 'type', classes := '[]::VARCHAR[]',
    pseudo := [{name: 'def', body: '(flags & 6) = 6'}])),
  source := 'read_parquet(''test/data/app.parquet'')'));

query II
SELECT (SELECT count(*) FROM tree_match('main', 'rep_class_none', tree_steps([{class: 'def'}]))),
       (SELECT count(*) FROM tree_match('main', 'rep_class_none', tree_steps([{pseudo: 'def'}])))
     = (SELECT count(*) FROM tree_match('main', 'rep_pseudo', tree_steps([{pseudo: 'def'}])));
----
0	true

# --------------------------------------------------------------------------------------
# (c) ELEMENT: a column, or a macro over the flag bit it was derived from
# --------------------------------------------------------------------------------------

# `is_element` is is_construct(flags), frozen into the fixture. On app.parquet (and on
# scripts and py_variety) that predicate is exactly this flag test, so the macro is a
# second representation of the same element set, not an approximation of it.

statement ok
CREATE MACRO is_construct_stub(f) AS (f & 1) = 0;

statement ok
CALL tree_ddl_create('main', 'rep_elem_col', tree_spec(tree_shape(
  root := 'file_path', "order" := 'node_id', level := 'depth',
  size := 'descendant_count',
  semantic := tree_semantic(type := 'type', id := 'name', classes := 'css_classes',
    element := 'is_element', pseudo := [{name: 'def', body: '(flags & 6) = 6'}])),
  source := 'read_parquet(''test/data/app.parquet'')'));

statement ok
CALL tree_ddl_create('main', 'rep_elem_stub', tree_spec(tree_shape(
  root := 'file_path', "order" := 'node_id', level := 'depth',
  size := 'descendant_count',
  semantic := tree_semantic(type := 'type', id := 'name', classes := 'css_classes',
    element := 'is_construct_stub(flags)', pseudo := [{name: 'def', body: '(flags & 6) = 6'}])),
  source := 'read_parquet(''test/data/app.parquet'')'));

statement ok
CALL tree_ddl_create('main', 'rep_elem_expr', tree_spec(tree_shape(
  root := 'file_path', "order" := 'node_id', level := 'depth',
  size := 'descendant_count',
  semantic := tree_semantic(type := 'type', id := 'name', classes := 'css_classes',
    element := 'regexp_matches(type, ''^[a-z_]'')', pseudo := [{name: 'def', body: '(flags & 6) = 6'}])),
  source := 'read_parquet(''test/data/app.parquet'')'));


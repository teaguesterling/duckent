# A DIFFERENT predicate is a different tree, and this is what that looks like:
# `^[a-z_]` admits the keyword tokens (`def`, `return`) that is_construct rejects, so
# under it the `def` keyword is the first element child of a function_definition and
# the name identifier no longer is. Not a bug -- the point of the section: ELEMENT is
# read, so (a) and the records above are not passing on an ignored declaration.
query II
SELECT (SELECT list(file_path || ':' || node_id ORDER BY file_path, node_id)
        FROM tree_match('main', 'rep_elem_col', 'function_definition > identifier:first-child', language := 'css')),
       (SELECT list(file_path || ':' || node_id ORDER BY file_path, node_id)
        FROM tree_match('main', 'rep_elem_expr', 'function_definition > identifier:first-child', language := 'css'));
----
[app.py:8, app.py:32]	NULL


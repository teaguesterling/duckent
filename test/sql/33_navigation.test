# name: test/sql/33_navigation.test
# description: one fragment per relation; element rows govern sibling and positional relations

statement ok
CALL tree_ddl_create('main', 'app', tree_spec(tree_shape(root := 'file_path', "order" := 'node_id', level := 'depth', size := 'descendant_count',
  semantic := tree_semantic(type := 'type')),
  source := 'read_parquet(''test/data/app.parquet'')'));

# reverse axes agree with the forward ones
query I
SELECT list(_pre ORDER BY _pre) FROM tree_parent('main', 'app', '{''file_path'': app.py}', 18);
----
[16]

query I
SELECT list(_pre ORDER BY _pre) FROM tree_siblings('main', 'app', '{''file_path'': app.py}', 8);
----
[7, 9, 13, 14]

query I
SELECT _pre FROM tree_prev_sibling('main', 'app', '{''file_path'': app.py}', 30);
----
6

query I
SELECT _pre FROM tree_last_child('main', 'app', '{''file_path'': app.py}', 6);
----
14

query I
SELECT list(_pre ORDER BY _pre) FROM tree_ancestors('main', 'app', '{''file_path'': app.py}', 18);
----
[0, 6, 14, 15, 16]

# element rows: the predicate admits named nodes and keyword tokens ('def', 'return'),
# so only the punctuation tokens -- '(' ')' ':' '{' '}' '.' -- are invisible
statement ok
CALL tree_ddl_create('main', 'elem', tree_spec(tree_shape(root := 'file_path', "order" := 'node_id', level := 'depth', size := 'descendant_count',
  semantic := tree_semantic(type := 'type', element := 'regexp_matches(type, ''^[a-z_]'')')),
  source := 'read_parquet(''test/data/app.parquet'')'));

# node 9 is `parameters` = ( name ): its element children are just the identifier at 11,
# so first and last child coincide
query II
SELECT (SELECT _pre FROM tree_first_child('main', 'elem', '{''file_path'': app.py}', 9)), (SELECT _pre FROM tree_last_child('main', 'elem', '{''file_path'': app.py}', 9));
----
11	11

# without an element predicate the first child of node 9 is the '(' token
query I
SELECT _pre FROM tree_first_child('main', 'app', '{''file_path'': app.py}', 9);
----
10

# next sibling skips the ':' token between the parameters list and the block under the element predicate
query II
SELECT (SELECT _pre FROM tree_next_sibling('main', 'elem', '{''file_path'': app.py}', 9)), (SELECT _pre FROM tree_next_sibling('main', 'app', '{''file_path'': app.py}', 9));
----
14	13

# ...but tree_siblings is NOT element-filtered, and that is deliberate rather than an oversight:
# "siblings" is every row sharing a parent, and it is the structural base tree_sql_after,
# tree_sql_before, next, prev, first-child and last-child each build on by ADDING the _element
# conjunct. Asking for the sibling SET is a structural question. So node 9's siblings on `elem`
# are the same four as on `app` -- including the ':' token at 13 that `next` skipped one record
# above. The inconsistency this leaves (tree_siblings unfiltered beside tree_next_sibling
# filtered) is an open item in FINDINGS; this record is what a decision to change it has to
# change, so it cannot be changed by accident.
query II
SELECT (SELECT list(_pre ORDER BY _pre) FROM tree_siblings('main', 'elem', '{''file_path'': app.py}', 9)),
       (SELECT count(*) FILTER (WHERE NOT _element) FROM tree_siblings('main', 'elem', '{''file_path'': app.py}', 9));
----
[7, 8, 13, 14]	1

# the same distinction through the match compiler, which picks the element-aware form from its own
# has_element flag rather than the traversal macros' unconditional true. node_id is the ORDER
# column, so node_id = _pre; _pre itself is excluded from a match result.
# Both `parameters` nodes (greet's at 9, shout's at 33) land on their `block` sibling...
query I
SELECT list(node_id ORDER BY node_id) FROM tree_match('main', 'elem', tree_steps([{type: 'parameters'}, {comb: 'next'}]));
----
[14, 38]

# ...while with no element predicate the same selector stops at the ':' token before each block
query I
SELECT list(node_id ORDER BY node_id) FROM tree_match('main', 'app', tree_steps([{type: 'parameters'}, {comb: 'next'}]));
----
[13, 37]

# the anchor pre is cast, not spliced: a non-numeric anchor cannot smuggle SQL into the WHERE
# clause, a string digit still names its row, and a NULL anchor selects nothing (as it did in M1)
query I
SELECT count(*) FROM tree_children('main', 'app', '{''file_path'': app.py}', NULL);
----
0

query I
SELECT list(_pre ORDER BY _pre) FROM tree_children('main', 'app', '{''file_path'': app.py}', '6');
----
[7, 8, 9, 13, 14]

statement error
SELECT count(*) FROM tree_children('main', 'app', '{''file_path'': app.py}', '6 OR true');
----
Could not convert string '6 OR true' to DOUBLE

# ... and the cast is to DOUBLE, not BIGINT, because BIGINT ROUNDS: `5.7` became 6 and the
# traversal answered with node 6's children -- an anchor the caller never named, silently. A
# fractional pre names no row of a tree whose _pre values are integers, so it matches nothing,
# which is the same answer a pre past the end of the partition gives.
query I
SELECT count(*) FROM tree_children('main', 'app', '{''file_path'': app.py}', 5.7);
----
0

# the ROOT KEY is spliced through tree_sql_lit, which is NULL for a NULL key -- and a NULL
# anywhere in the text makes the WHOLE text NULL, which query() refuses outright ("syntax error
# at or near NULL"). A caller asking about a partition that is not there is owed the empty
# answer M1 gave, not a parser error from inside a macro it never wrote.
query I
SELECT count(*) FROM tree_children('main', 'app', NULL, 6);
----
0

query I
SELECT count(*) FROM tree_descendants('main', 'app', NULL, 0);
----
0

# sibling relations stay inside their own ROOT partition: two copies of the fixture under distinct
# root keys give node 8 the same four siblings it has alone, not eight
statement ok
CREATE TABLE two AS
  SELECT * REPLACE ('a.py' AS file_path) FROM read_parquet('test/data/app.parquet')
  UNION ALL
  SELECT * REPLACE ('b.py' AS file_path) FROM read_parquet('test/data/app.parquet');

statement ok
CALL tree_ddl_create('main', 'pair', tree_spec(tree_shape(root := 'file_path', "order" := 'node_id', level := 'depth', size := 'descendant_count'), source := 'two'));

query I
SELECT list(_pre ORDER BY _pre) FROM tree_siblings('main', 'pair', '{''file_path'': a.py}', 8);
----
[7, 9, 13, 14]

# ---------------------------------------------------------------------------------------
# The two forms of :first-child / :last-child agree, ROOT ROWS INCLUDED
# ---------------------------------------------------------------------------------------
#
# Each positional relation has two spellings: the O(1) one that reads _pre and _parent, used
# when no row can be a non-element, and the scan that looks for a nearer element sibling, used
# when ELEMENT is declared. They are meant to be the same relation, so a tree that declares
# `element := 'true'` -- where every row is an element and the scan therefore asks exactly what
# the arithmetic asks -- must answer identically to one that declares no ELEMENT at all.
#
# They did not. A level-0 row has a NULL _parent, so the O(1) first-child form `_pre = _parent + 1`
# was NULL, which reads as false: the first ROOT of a partition was a first child under the scan
# and not under the arithmetic. A partition's first root IS its parent's first child in the only
# sense the tree has -- it is the first row at level 0 -- so the O(1) form says so now
# (`COALESCE(_pre = _parent + 1, _pre = 0)`). last-child already agreed, because its O(1) form is
# the scan without the element conjunct, and this record is what keeps that true.
statement ok
CALL tree_ddl_create('main', 'ne', tree_spec(tree_shape(root := 'file_path', "order" := 'node_id', level := 'depth', size := 'descendant_count',
  semantic := tree_semantic(type := 'type')), source := 'read_parquet(''test/data/app.parquet'')'));

statement ok
CALL tree_ddl_create('main', 'el', tree_spec(tree_shape(root := 'file_path', "order" := 'node_id', level := 'depth', size := 'descendant_count',
  semantic := tree_semantic(type := 'type', element := 'true')), source := 'read_parquet(''test/data/app.parquet'')'));

# the row sets, not just their sizes
query II
SELECT (SELECT list(node_id ORDER BY node_id) FROM tree_match('main', 'ne', tree_steps([{pseudo: 'first-child'}])))
     = (SELECT list(node_id ORDER BY node_id) FROM tree_match('main', 'el', tree_steps([{pseudo: 'first-child'}]))),
       (SELECT list(node_id ORDER BY node_id) FROM tree_match('main', 'ne', tree_steps([{pseudo: 'last-child'}])))
     = (SELECT list(node_id ORDER BY node_id) FROM tree_match('main', 'el', tree_steps([{pseudo: 'last-child'}])));
----
true	true

# ... and the totals, so that a change breaking both forms the same way still shows up here.
# app.py is one partition of 54 rows: 21 of them are a first child and 21 a last child, the
# module at node 0 (the partition's only level-0 row) counting as both. `ne` answered 20 and 21
# before the fix -- the one missing row being that module.
query IIII
SELECT (SELECT count(*) FROM tree_match('main', 'ne', tree_steps([{pseudo: 'first-child'}]))),
       (SELECT count(*) FROM tree_match('main', 'el', tree_steps([{pseudo: 'first-child'}]))),
       (SELECT count(*) FROM tree_match('main', 'ne', tree_steps([{pseudo: 'last-child'}]))),
       (SELECT count(*) FROM tree_match('main', 'el', tree_steps([{pseudo: 'last-child'}])));
----
21	21	21	21

# the root row itself, named: node 0 is app.py's module, the partition's only level-0 row
query II
SELECT (SELECT count(*) FROM tree_match('main', 'ne', tree_steps([{pseudo: 'first-child', "where": 'node_id = 0'}]))),
       (SELECT count(*) FROM tree_match('main', 'el', tree_steps([{pseudo: 'first-child', "where": 'node_id = 0'}])));
----
1	1

# ... and they agree on an ORDER that is NEITHER DENSE NOR ZERO-BASED, which is the property the
# O(1) forms actually rest on.
#
# `:first-child` compiles to `COALESCE(_pre = _parent + 1, _pre = 0)` and `:last-child` to a lookup
# at `_pre + _size + 1`. Both are arithmetic on _pre, and both are valid ONLY because _pre is the
# RANK of ORDER within ROOT (M3 §2.1), not the ORDER value: a projection that cast ORDER straight
# to _pre -- which is what this used to do, and is "only ever right for a source whose ORDER was
# already dense and 0-based per root" (sql/02_projection.sql) -- would break them.
#
# Every test above uses app.parquet, whose node_id is already dense and 0-based, so none of them
# can tell the two apart. Here x's ORDER is 0/10/20 and y's is 100/110/120: if _pre were the ORDER
# value, `_pre = _parent + 1` would be false for x's first child (10 <> 0 + 1) and for y's
# (110 <> 100 + 1), and y's root would fail `_pre = 0` as well.
statement ok
CREATE TABLE gapped AS SELECT * FROM (VALUES
  ('x',   0, 0, 'r'), ('x',  10, 1, 'a'), ('x',  20, 1, 'b'),
  ('y', 100, 0, 'r'), ('y', 110, 1, 'a'), ('y', 120, 1, 'b')) t(f, ord, lvl, nm);

statement ok
CALL tree_ddl_create('main', 'gne', tree_spec(tree_shape(root := 'f', "order" := 'ord', level := 'lvl',
  semantic := tree_semantic(type := 'nm')), source := 'gapped'));

statement ok
CALL tree_ddl_create('main', 'gel', tree_spec(tree_shape(root := 'f', "order" := 'ord', level := 'lvl',
  semantic := tree_semantic(type := 'nm', element := 'true')), source := 'gapped'));

# each partition's root is its own first and last child, as app.py's module is above
query II
SELECT (SELECT list(f || '.' || nm ORDER BY f, ord) FROM tree_match('main', 'gne', tree_steps([{pseudo: 'first-child'}]))),
       (SELECT list(f || '.' || nm ORDER BY f, ord) FROM tree_match('main', 'gne', tree_steps([{pseudo: 'last-child'}])));
----
[x.r, x.a, y.r, y.a]	[x.r, x.b, y.r, y.b]

# and the two spellings still answer the same relation on this shape
query II
SELECT (SELECT list(f || '.' || nm ORDER BY f, ord) FROM tree_match('main', 'gne', tree_steps([{pseudo: 'first-child'}])))
     = (SELECT list(f || '.' || nm ORDER BY f, ord) FROM tree_match('main', 'gel', tree_steps([{pseudo: 'first-child'}]))),
       (SELECT list(f || '.' || nm ORDER BY f, ord) FROM tree_match('main', 'gne', tree_steps([{pseudo: 'last-child'}])))
     = (SELECT list(f || '.' || nm ORDER BY f, ord) FROM tree_match('main', 'gel', tree_steps([{pseudo: 'last-child'}])));
----
true	true

# ---------------------------------------------------------------------------------------
# The sibling and positional relations are LINEAR in the number of children of one parent
# ---------------------------------------------------------------------------------------
#
# One root and 2999 children, every third one a non-element. The element-aware forms used to ask
# "is there a nearer element sibling?" as a NOT EXISTS correlated to each candidate PAIR, which is
# worse than quadratic in the width of a single parent: 0.23 s at 600 children, 3.5 s at 1200,
# 87.6 s at 2400, and at the 3000 this record uses it does not finish at all -- it exhausts 6 GB of
# memory and 24 GB of spill (test/spike_listspace.py --siblings). The __sib window
# answers it for every row in one pass and it runs in seconds. The SIZE is what makes the
# difference visible, so this is the record that would notice a scan coming back -- but it pins
# ANSWERS, not a time, and the answers are the same ones the scanning form gave.
#
# All three are computed from the definitions rather than read off the implementation:
#
#   next  -- every element child but the last has exactly one next element sibling, and here every
#            element IS an `item` (element is `type <> 'punct'`), so the count is the number of
#            items at level 1 minus one:
#            `SELECT count(*) - 1 FROM range(1, 3000) t(i) WHERE i % 3 <> 1` = 1998.
#   first -- min is 0, NOT the first item child at 2. Node 0 is the partition's only level-0 row,
#            so it has no earlier element sibling and IS a first child -- the same rule the `ne`/`el`
#            records above pin, and the reason tree_sql_siblings relates level-0 rows through
#            IS NOT DISTINCT FROM. It is also an item (0 % 3 = 0), so it is in this match set and
#            it is the smallest node_id in it. __sib gets the same answer by the same road: it
#            partitions by (_root, _parent), which groups the level-0 rows through their NULL.
#   last  -- node 2999 is an item (2999 % 3 = 2) and the partition's last row.
statement ok
CREATE TABLE wide AS SELECT 'w' AS file_path, i AS node_id, (i > 0)::INT AS depth, CASE WHEN i = 0 THEN 2999 ELSE 0 END AS descendant_count,
  CASE WHEN i % 3 = 1 THEN 'punct' ELSE 'item' END AS type FROM range(3000) t(i);

statement ok
CALL tree_ddl_create('main', 'wide', tree_spec(tree_shape(root := 'file_path', "order" := 'node_id', level := 'depth', size := 'descendant_count',
  semantic := tree_semantic(type := 'type', element := 'type <> ''punct''')), source := 'wide'));

query III
SELECT (SELECT count(*) FROM tree_match('main', 'wide', tree_steps([{type: 'item'}, {comb: 'next', type: 'item'}]))),
       (SELECT min(node_id) FROM tree_match('main', 'wide', tree_steps([{type: 'item', pseudo: 'first-child'}]))),
       (SELECT max(node_id) FROM tree_match('main', 'wide', tree_steps([{type: 'item', pseudo: 'last-child'}])));
----
1998	0	2999

# ---------------------------------------------------------------------------------------
# Several level-0 rows in ONE partition, and a NON-ELEMENT tree
# ---------------------------------------------------------------------------------------
#
# The keyed last-child form asks whether the row at `_pre + _size + 1` is a SIBLING, and it must
# compare parents with IS NOT DISTINCT FROM. Level-0 rows carry a NULL _parent, so under plain `=`
# the comparison is NULL, the NOT EXISTS finds nothing, and EVERY root of the partition reads as a
# last child. That is F7's bug class (FINDINGS: "next/after compared b._parent = a._parent ... so
# the root rows of a partition were never each other's siblings") reappearing in a form M3 Task 8
# introduced -- the pre-Task-8 form scanned for a later sibling and never did this arithmetic.
#
# 10 roots at level 0 (node_id 0, 3, ... 27), each with two level-1 children. Counted from the
# definitions: the last child of each root is its second child (10 rows), plus node 27, which is
# the partition's last level-0 row and so has no later sibling of its own -- 11. Under `=` the
# answer is 20, because the 10 roots wrongly join the set.
statement ok
CREATE TABLE forest AS SELECT 'f' AS file_path, i AS node_id, (i % 3 <> 0)::INT AS depth,
  CASE WHEN i % 3 = 0 THEN 2 ELSE 0 END AS descendant_count, 'n' AS type FROM range(30) t(i);

statement ok
CALL tree_ddl_create('main', 'forest', tree_spec(tree_shape(root := 'file_path', "order" := 'node_id',
  level := 'depth', size := 'descendant_count', semantic := tree_semantic(type := 'type')), source := 'forest'));

query I
SELECT count(*) FROM tree_match('main', 'forest', tree_steps([{pseudo: 'last-child'}]));
----
11

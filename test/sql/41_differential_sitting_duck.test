# name: test/sql/41_differential_sitting_duck.test
# description: every sitting_duck_supported astcss-eval row against its FROZEN
# reference (node keys and sha256). No sitting_duck: the fixtures carry css_classes,
# is_element and params, so these run on the parquet alone. 41b is the live twin.
#
# References are copied verbatim from ~/Projects/astcss-eval/pairs/accepted-b*.jsonl
# and are never edited. A row we adjudicated against upstream is commented out below
# with its reason; see FINDINGS.md, "M2 differential adjudications".
#
# GENERATED by test/import_astcss_eval.py from test/corpus/selectors.tsv and
# ~/Projects/astcss-eval/pairs/accepted-b*.jsonl -- do not edit by hand.

# The corpus trees. CLASSES, ELEMENT and `params` are columns test/gen_fixtures.py
# derived from sitting_duck at fixture time, so nothing here needs the extension.

statement ok
CALL tree_ddl_create('main', 'scripts', tree_spec(tree_shape(
  root := 'file_path', "order" := 'node_id', level := 'depth', size := 'descendant_count',
  semantic := tree_semantic(type := 'type', id := 'name', classes := 'css_classes',
    element := 'is_element', pseudo := [{name: 'def', body: '(flags & 6) = 6'}])),
  source := 'read_parquet(''test/data/scripts.parquet'')'));

statement ok
CALL tree_ddl_create('main', 'py_variety', tree_spec(tree_shape(
  root := 'file_path', "order" := 'node_id', level := 'depth', size := 'descendant_count',
  semantic := tree_semantic(type := 'type', id := 'name', classes := 'css_classes',
    element := 'is_element', pseudo := [{name: 'def', body: '(flags & 6) = 6'}])),
  source := 'read_parquet(''test/data/py_variety.parquet'')'));

# t1-p01  .class  [py_variety]  19 nodes
query I
SELECT list(regexp_replace(file_path, '.*/', '') || ':' || node_id ORDER BY file_path, node_id)
FROM (SELECT DISTINCT file_path, node_id
      FROM tree_match('main', 'py_variety', '.class', language := 'css'));

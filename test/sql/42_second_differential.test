query I
SELECT (SELECT list(file_path || ':' || node_id ORDER BY file_path, node_id)
        FROM tree_match('main', 'app_declared', 'function_definition', language := 'css'))
     = (SELECT list(file_path || ':' || node_id ORDER BY file_path, node_id)
        FROM tree_match('main', 'app_derived', 'function_definition', language := 'css'));

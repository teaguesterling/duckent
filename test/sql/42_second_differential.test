# name: test/sql/42_second_differential.test
# description: the second differential -- one tree whose SIZE, PARENT and CHILDREN are
# declared columns against one that derives all three, over every app corpus selector.
# Child, sibling and positional steps read PARENT; descendant steps and :has/:not read
# SIZE. A derivation that disagreed with the parquet's own numbers would move rows.
#
# The selectors are the `app` rows of test/corpus/selectors.tsv, plus the one written
# below for SIZE. astcss-eval's rows all target scripts/py_variety, so none of them is
# templated here.
#
# GENERATED by test/import_astcss_eval.py from test/corpus/selectors.tsv and
# ~/Projects/astcss-eval/pairs/accepted-b*.jsonl -- do not edit by hand.

# The two trees. Same source, same S group; only the O group differs.

statement ok
CALL tree_ddl_create('main', 'app_declared', tree_spec(tree_shape(
  root := 'file_path', "order" := 'node_id', level := 'depth',
  size := 'descendant_count', parent := 'parent_id', children := 'children_count',
  semantic := tree_semantic(type := 'type', id := 'name', classes := 'css_classes',
    element := 'is_element', pseudo := [{name: 'def', body: '(flags & 6) = 6'}])),
  source := 'read_parquet(''test/data/app.parquet'')'));

statement ok
CALL tree_ddl_create('main', 'app_derived', tree_spec(tree_shape(
  root := 'file_path', "order" := 'node_id', level := 'depth',
  semantic := tree_semantic(type := 'type', id := 'name', classes := 'css_classes',
    element := 'is_element', pseudo := [{name: 'def', body: '(flags & 6) = 6'}])),
  source := 'read_parquet(''test/data/app.parquet'')'));

# The two projections first, column for column. The selector records below are the
# observable consequences, but they cannot be the whole claim: no selector reads
# CHILDREN at all, and with ELEMENT declared the sibling and positional fragments
# take the element-scan path rather than the O(1) pre/size arithmetic, so a wrong
# SIZE or CHILDREN would be invisible to every one of them but the last.
query III
SELECT (SELECT count(*) FROM tree_project('main', 'app_declared'))
     = (SELECT count(*) FROM tree_project('main', 'app_derived')),
       (SELECT count(*) > 0 FROM tree_project('main', 'app_declared')),
       (SELECT count(*) FROM tree_project('main', 'app_declared') d
          JOIN tree_project('main', 'app_derived') v ON d._root = v._root AND d._pre = v._pre
         WHERE d._size IS DISTINCT FROM v._size OR d._parent IS DISTINCT FROM v._parent
            OR d._children IS DISTINCT FROM v._children);
----
true	true	0

# attribute identifier -- the one selector on this fixture whose answer reads SIZE: app.py:50 is the last
# descendant of its `attribute`, so a subtree range one short of the declared size drops
# it. Written here rather than in the corpus, which has no selector of that shape.
query I
SELECT (SELECT list(file_path || ':' || node_id ORDER BY file_path, node_id)
        FROM tree_match('main', 'app_declared', 'attribute identifier', language := 'css'))
     = (SELECT list(file_path || ':' || node_id ORDER BY file_path, node_id)
        FROM tree_match('main', 'app_derived', 'attribute identifier', language := 'css'));
----
true


# name: test/sql/40_corpus.test
# description: P22 -- the treeql and the css spelling of one selector match the same
# rows and print as the same canonical TREEQL, over the whole corpus
#
# The `tree_steps([...])` literals are the hand corpus (test/corpus/selectors.tsv); the
# `[...]::TREE_SELECTOR` literals are the IR the runner's css parser built for the
# astcss-eval row, stored in test/corpus/astcss_eval.jsonl as `treeql_ir`.
#
# GENERATED by test/import_astcss_eval.py from test/corpus/selectors.tsv and
# ~/Projects/astcss-eval/pairs/accepted-b*.jsonl -- do not edit by hand.

# The corpus trees. CLASSES, ELEMENT and `params` are columns test/gen_fixtures.py
# derived from sitting_duck at fixture time, so nothing here needs the extension.

statement ok
CALL tree_ddl_create('main', 'app', tree_spec(tree_shape(
  root := 'file_path', "order" := 'node_id', level := 'depth', size := 'descendant_count',
  semantic := tree_semantic(type := 'type', id := 'name', classes := 'css_classes',
    element := 'is_element', pseudo := [{name: 'def', body: '(flags & 6) = 6'}])),
  source := 'read_parquet(''test/data/app.parquet'')'));

statement ok
CALL tree_ddl_create('main', 'scripts', tree_spec(tree_shape(
  root := 'file_path', "order" := 'node_id', level := 'depth', size := 'descendant_count',
  semantic := tree_semantic(type := 'type', id := 'name', classes := 'css_classes',
    element := 'is_element', pseudo := [{name: 'def', body: '(flags & 6) = 6'}])),
  source := 'read_parquet(''test/data/scripts.parquet'')'));

statement ok
CALL tree_ddl_create('main', 'py_variety', tree_spec(tree_shape(
  root := 'file_path', "order" := 'node_id', level := 'depth', size := 'descendant_count',
  semantic := tree_semantic(type := 'type', id := 'name', classes := 'css_classes',
    element := 'is_element', pseudo := [{name: 'def', body: '(flags & 6) = 6'}])),
  source := 'read_parquet(''test/data/py_variety.parquet'')'));

# --------------------------------------------------------------------------------------
# the hand corpus: test/corpus/selectors.tsv
# --------------------------------------------------------------------------------------

# c01  function_definition  [app]  portable sitting_duck_supported
query I
SELECT (SELECT list(file_path || ':' || node_id ORDER BY file_path, node_id) FROM tree_match('main', 'app', tree_steps([{type: 'function_definition'}])))
     = (SELECT list(file_path || ':' || node_id ORDER BY file_path, node_id) FROM tree_match('main', 'app', 'function_definition', language := 'css'));
----
true

query I
SELECT tree_selector_to_treeql(tree_steps([{type: 'function_definition'}]))
     = (tree_explain('main', 'app', 'function_definition', language := 'css')).treeql;
----
true


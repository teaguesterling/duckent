# c01  function_definition  [app]  portable sitting_duck_supported
query I
SELECT tree_parse_css('function_definition')
     = [{node_id: 0, parent_id: NULL, kind: 'selector', value: 'css', op: NULL, arg: NULL, alias: NULL}, {node_id: 1, parent_id: 0, kind: 'step', value: NULL, op: NULL, arg: NULL, alias: NULL}, {node_id: 2, parent_id: 1, kind: 'type', value: 'function_definition', op: NULL, arg: NULL, alias: NULL}]::TREE_SELECTOR;
----
true

query I
SELECT tree_selector_to_treeql(tree_parse_css('function_definition'))
     = (tree_explain('main', 'app', 'function_definition', language := 'css')).treeql;
----
true


# name: test/sql/44_parsers.test
# description: the parser differential -- the runner's css parser (test/css_parser.py)
# and the SQL front-end (tree_parse_css / tree_css_lower) build the same IR, and print
# the same canonical TREEQL, for every css row of both corpora.
#
# The `[...]::TREE_SELECTOR` literals are the runner parser's own output, frozen. The
# second record of each pair re-parses the text with the runner at test time, so the
# two records fail for different reasons: the first when the lowering drifts, the
# second when either front-end does.
#
# GENERATED by test/import_astcss_eval.py from test/corpus/selectors.tsv and
# ~/Projects/astcss-eval/pairs/accepted-b*.jsonl -- do not edit by hand.

require sitting_duck

statement ok
LOAD sitting_duck;

# MN22 bait. A partition row marked NOT P13-clean, for a tree name nothing here (or
# anywhere else) declares: no record below reads tree_state, so this row is invisible
# to a front-end that lowers a selector from its text alone -- and fatal to one that
# consults engine state, which is the mutant.
statement ok
INSERT INTO tree_state.partitions
VALUES (current_database(), 'main', '__mn22_absent', 'x', 0, 0, false, NULL);

# The corpus trees. CLASSES, ELEMENT and `params` are columns test/gen_fixtures.py
# derived from sitting_duck at fixture time, so nothing here needs the extension.

statement ok
CALL tree_ddl_create('main', 'app', tree_spec(tree_shape(
  root := 'file_path', "order" := 'node_id', level := 'depth', size := 'descendant_count',
  semantic := tree_semantic(type := 'type', id := 'name', classes := 'css_classes',
    element := 'is_element', pseudo := [{name: 'def', body: '(flags & 6) = 6'}])),
  source := 'read_parquet(''test/data/app.parquet'')'));

statement ok
CALL tree_ddl_create('main', 'scripts', tree_spec(tree_shape(
  root := 'file_path', "order" := 'node_id', level := 'depth', size := 'descendant_count',
  semantic := tree_semantic(type := 'type', id := 'name', classes := 'css_classes',
    element := 'is_element', pseudo := [{name: 'def', body: '(flags & 6) = 6'}])),
  source := 'read_parquet(''test/data/scripts.parquet'')'));

statement ok
CALL tree_ddl_create('main', 'py_variety', tree_spec(tree_shape(
  root := 'file_path', "order" := 'node_id', level := 'depth', size := 'descendant_count',
  semantic := tree_semantic(type := 'type', id := 'name', classes := 'css_classes',
    element := 'is_element', pseudo := [{name: 'def', body: '(flags & 6) = 6'}])),
  source := 'read_parquet(''test/data/py_variety.parquet'')'));


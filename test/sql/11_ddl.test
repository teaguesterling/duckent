# name: test/sql/11_ddl.test
# description: create, LIKE, SHAPE ONLY, storage modes, refusals, drop, alter

# materialized concrete tree over the app fixture
statement ok
CALL tree_ddl_create('main', 'app', tree_spec(
  tree_shape(root := 'file_path', "order" := 'node_id', level := 'depth', size := 'descendant_count',
             semantic := tree_semantic(type := 'type', id := 'name', pseudo := [{name: 'leaf', body: 'descendant_count = 0'}])),
  source := 'read_parquet(''test/data/app.parquet'')'));

query IIIIII
SELECT is_abstract, basis, profile, storage, order_source, has_semantic FROM tree_catalog_trees() WHERE tree_name = 'app';
----
false	level	full	materialized	declared	true

query II rowsort
SELECT block, slot FROM tree_catalog_slots() WHERE tree_name = 'app';
----
O	SIZE
R	LEVEL
R	ORDER
R	ROOT
S	ATTR
S	ID
S	TYPE

query I
SELECT expression FROM tree_catalog_slots() WHERE tree_name = 'app' AND slot = 'ATTR';
----
*

query II
SELECT count(*), max(_pre) FROM tree_project('main', 'app');
----
54	53

query III
SELECT root_key, epoch, row_count FROM tree_state.partitions WHERE tree_name = 'app';
----
{'file_path': app.py}	1	54

query I rowsort
SELECT artifact FROM tree_catalog.compiled WHERE tree_name = 'app';
----
attribute_columns
projection

# classes introspection is empty for a tree without CLASSES
query I
SELECT count(*) FROM tree_catalog_classes('main', 'app');
----
0

# duplicate name refused
statement error
CALL tree_ddl_create('main', 'app', tree_spec(tree_shape(level := 'depth'), source := 'read_parquet(''test/data/app.parquet'')'));
----
already exists

# abstract shape, closed by default
statement ok
CALL tree_ddl_create('main', 'ast_shape', tree_spec(tree_shape(root := 'file_path', "order" := 'node_id', level := 'depth', semantic := tree_semantic(type := 'type')), abstract := true));

query II
SELECT is_abstract, (SELECT expression FROM tree_catalog_slots() s WHERE s.tree_name = 'ast_shape' AND slot = 'ATTR') FROM tree_catalog_trees() WHERE tree_name = 'ast_shape';
----
true	(empty)

# abstract with a source refused; concrete without a source refused
statement error
CALL tree_ddl_create('main', 'bad1', tree_spec(tree_shape(level := 'depth'), abstract := true, source := 'read_parquet(''test/data/app.parquet'')'));
----
SHAPE ONLY

statement error
CALL tree_ddl_create('main', 'bad2', tree_spec(tree_shape(level := 'depth')));
----
SHAPE ONLY

# LIKE copies semantics, never source; instance stays closed
statement ok
CALL tree_ddl_create('main', 'code', tree_spec(tree_shape(), "like" := 'ast_shape', source := 'read_parquet(''test/data/app.parquet'')', storage := 'projection'));

query III
SELECT like_tree, storage, (SELECT expression FROM tree_catalog_slots() s WHERE s.tree_name = 'code' AND slot = 'TYPE') FROM tree_catalog_trees() WHERE tree_name = 'code';
----
ast_shape	projection	type

query I
SELECT count(*) FROM (DESCRIBE FROM tree_project('main', 'code')) WHERE column_name = 'peek';
----
0

# LIKE of an unknown tree refused, naming it
statement error
CALL tree_ddl_create('main', 'bad3', tree_spec(tree_shape(), "like" := 'nope', source := 'read_parquet(''test/data/app.parquet'')'));
----
nope

# R2: LEVEL or PARENT required
statement error
CALL tree_ddl_create('main', 'bad4', tree_spec(tree_shape("order" := 'node_id'), source := 'read_parquet(''test/data/app.parquet'')'));
----
LEVEL or PARENT

# parent basis requires KEY
statement error
CALL tree_ddl_create('main', 'bad5', tree_spec(tree_shape(parent := 'manager_email'), source := 'read_csv(''test/data/employees.csv'')'));
----
KEY

# projection mode requires ORDER
statement error
CALL tree_ddl_create('main', 'bad6', tree_spec(tree_shape(level := 'depth'), source := 'read_parquet(''test/data/app.parquet'')', storage := 'projection'));
----
ORDER

# frozen order (no ORDER declared) is refused while preserve_insertion_order is off, because
# the scan sequence _pre would be taken from is not the source's order (T6)
statement ok
SET preserve_insertion_order = false;

statement error
CALL tree_ddl_create('main', 'bad12', tree_spec(tree_shape(root := 'file_path', level := 'depth'), source := 'read_parquet(''test/data/app.parquet'')'));
----
preserve_insertion_order

statement ok
SET preserve_insertion_order = true;

# the same shape is accepted once the setting is back on
statement ok
CALL tree_ddl_create('main', 'frozen', tree_spec(tree_shape(root := 'file_path', level := 'depth'), source := 'read_parquet(''test/data/app.parquet'')'));

query I
SELECT order_source FROM tree_catalog_trees() WHERE tree_name = 'frozen';
----
frozen

# a parent-basis KEY must be a plain column name, not an expression the encoder cannot qualify (T6)
statement error
CALL tree_ddl_create('main', 'bad13', tree_spec(tree_shape(key := 'lower(email)', parent := 'manager_email'), source := 'read_csv(''test/data/employees.csv'')'));
----
plain column names

# ATTR alias colliding with the canonical prefix refused
statement error
CALL tree_ddl_create('main', 'bad7', tree_spec(tree_shape("order" := 'node_id', level := 'depth', semantic := tree_semantic(attr := 'name AS _pre')), source := 'read_parquet(''test/data/app.parquet'')'));
----
_pre

# duplicate pseudo names refused (S-coherence)
statement error
CALL tree_ddl_create('main', 'bad8', tree_spec(tree_shape("order" := 'node_id', level := 'depth', semantic := tree_semantic(pseudo := [{name: 'x', body: 'true'}, {name: 'x', body: 'false'}])), source := 'read_parquet(''test/data/app.parquet'')'));
----
S-coherence

# NULL storage refuses: three-valued logic used to let it through the NOT IN check, and the
# trees INSERT (whose text interpolates storage) then compiled to NULL and was filtered out,
# leaving a table, a macro and partitions with no catalog row (I3)
statement error
CALL tree_ddl_create('main', 'bad9', tree_spec(tree_shape("order" := 'node_id', level := 'depth'), source := 'read_parquet(''test/data/app.parquet'')', storage := NULL));
----
storage must be

query IIII
SELECT (SELECT count(*) FROM tree_catalog_trees() WHERE tree_name = 'bad9'),
       (SELECT count(*) FROM tree_catalog_slots() WHERE tree_name = 'bad9'),
       (SELECT count(*) FROM tree_state.partitions WHERE tree_name = 'bad9'),
       (SELECT count(*) FROM duckdb_functions() WHERE tree_sql_ident(function_name) = tree_sql_object_name('proj', 'main', 'bad9'));
----
0	0	0	0

# identity is required
statement error
CALL tree_ddl_create('main', NULL, tree_spec(tree_shape("order" := 'node_id', level := 'depth'), source := 'read_parquet(''test/data/app.parquet'')'));
----
schema and name are required

# an implicit (AS-less) attribute alias cannot shadow a canonical column either: the regex
# refusal only sees "AS _x", so the compiled projection is described and the displaced
# duplicate (_size_1) is the proof
statement error
CALL tree_ddl_create('main', 'bad10', tree_spec(tree_shape("order" := 'node_id', level := 'depth', semantic := tree_semantic(attr := 'CAST(depth AS BIGINT) _size, name')), source := 'read_parquet(''test/data/app.parquet'')'));
----
shadows a canonical column: _size

# NULL abstract refuses: it is interpolated into the trees INSERT, which would compile to NULL
statement error
CALL tree_ddl_create('main', 'bad14', tree_spec(tree_shape("order" := 'node_id', level := 'depth'), source := 'read_parquet(''test/data/app.parquet'')', abstract := NULL));
----
abstract must be true or false

# a PSEUDO with no body refuses: the pseudo map and the pseudo_classes INSERT both go NULL
statement error
CALL tree_ddl_create('main', 'bad15', tree_spec(tree_shape("order" := 'node_id', level := 'depth', semantic := tree_semantic(pseudo := [{name: 'p', body: NULL}])), source := 'read_parquet(''test/data/app.parquet'')'));
----
every PSEUDO needs a name and a body

statement error
CALL tree_ddl_create('main', 'bad16', tree_spec(tree_shape("order" := 'node_id', level := 'depth', semantic := tree_semantic(pseudo := [{name: NULL, body: 'true'}])), source := 'read_parquet(''test/data/app.parquet'')'));
----
every PSEUDO needs a name and a body

# none of the three left a partial catalog behind
query IIII
SELECT (SELECT count(*) FROM tree_catalog_trees() WHERE tree_name IN ('bad10', 'bad14', 'bad15', 'bad16')),
       (SELECT count(*) FROM tree_catalog_slots() WHERE tree_name IN ('bad10', 'bad14', 'bad15', 'bad16')),
       (SELECT count(*) FROM tree_catalog.pseudo_classes WHERE tree_name IN ('bad10', 'bad14', 'bad15', 'bad16')),
       (SELECT count(*) FROM duckdb_functions() WHERE list_contains(list_transform(['bad10', 'bad14', 'bad15', 'bad16'], lambda x: tree_sql_object_name('proj', 'main', x)), tree_sql_ident(function_name)));
----
0	0	0	0

# altering a tree that does not exist refuses instead of compiling to NULL
statement error
CALL tree_ddl_alter('main', 'nope', tree_semantic(type := 'x'));
----
not found

# a LIKE child inherits the parent's SEMANTIC group whatever slot the parent declared:
# has_semantic follows the parent's own has_semantic, not just its TYPE
statement ok
CALL tree_ddl_create('main', 'id_shape', tree_spec(tree_shape(root := 'file_path', "order" := 'node_id', level := 'depth', semantic := tree_semantic(id := 'name')), abstract := true));

statement ok
CALL tree_ddl_create('main', 'kid', tree_spec(tree_shape(), "like" := 'id_shape', source := 'read_parquet(''test/data/app.parquet'')'));

query I
SELECT has_semantic FROM tree_catalog_trees() WHERE tree_name = 'kid';
----
true

query I
SELECT count(*) FROM tree_match('main', 'kid', tree_steps([{id: 'greet(name).upper'}]));
----
1

# the converse: an S-less parent stays S-less through LIKE. Every tree stores an S/ATTR slot
# ('' for a closed abstract, '*' for an open concrete one), so the merged shape of any LIKE
# child has a non-NULL semantic.attr -- counting ATTR as an S declaration would make every
# child S-ful and silently open the S-clause back door tree_match is supposed to refuse.
statement ok
CALL tree_ddl_create('main', 'sless', tree_spec(tree_shape(root := 'file_path', "order" := 'node_id', level := 'depth'), abstract := true));

statement ok
CALL tree_ddl_create('main', 'kid2', tree_spec(tree_shape(), "like" := 'sless', source := 'read_parquet(''test/data/app.parquet'')'));

query II
SELECT (SELECT has_semantic FROM tree_catalog_trees() WHERE tree_name = 'sless'),
       (SELECT has_semantic FROM tree_catalog_trees() WHERE tree_name = 'kid2');
----
false	false

statement error
SELECT count(*) FROM tree_match('main', 'kid2', tree_steps([{type: 'function_definition'}]));
----
has no SEMANTIC group

# parent basis, sibling-free profile recorded
statement ok
CALL tree_ddl_create('main', 'cats', tree_spec(tree_shape(key := 'cat_id', parent := 'parent_id'), source := 'read_csv(''test/data/categories.csv'')'));

query II
SELECT basis, profile FROM tree_catalog_trees() WHERE tree_name = 'cats';
----
parent	sibling_free

# R-only tree: no SEMANTIC group, type defaults to node
statement ok
CALL tree_ddl_create('main', 'bare', tree_spec(tree_shape("order" := 'node_id', level := 'depth'), source := 'read_parquet(''test/data/app.parquet'')'));

query II
SELECT has_semantic, (SELECT min(_type) FROM tree_project('main', 'bare')) FROM tree_catalog_trees() WHERE tree_name = 'bare';
----
false	node

# alter adds the SEMANTIC group later and rebuilds
statement ok
CALL tree_ddl_alter('main', 'bare', tree_semantic(type := 'type', classes := '[type]'));

query II
SELECT has_semantic, (SELECT _type FROM tree_project('main', 'bare') WHERE _pre = 6) FROM tree_catalog_trees() WHERE tree_name = 'bare';
----
true	function_definition

query II
SELECT class, row_count FROM tree_catalog_classes('main', 'bare') WHERE class = 'function_definition';
----
function_definition	2

# alter runs the same S validation ladder as create (C2)
statement error
CALL tree_ddl_alter('main', 'bare', tree_semantic(attr := 'node_id AS _pre'));
----
_pre

statement error
CALL tree_ddl_alter('main', 'bare', tree_semantic(pseudo := [{name: 'x', body: 'true'}, {name: 'x', body: 'false'}]));
----
S-coherence

statement error
CALL tree_ddl_alter('main', 'bare', NULL);
----
nothing to alter

# a closed tree stays closed across alter: ATTR defaults to the slot it already has, never to *
statement ok
CALL tree_ddl_create('main', 'shut', tree_spec(tree_shape("order" := 'node_id', level := 'depth', semantic := tree_semantic(type := 'type', attr := 'name')), source := 'read_parquet(''test/data/app.parquet'')'));

statement ok
CALL tree_ddl_alter('main', 'shut', tree_semantic(type := 'type', id := 'name'));

query II
SELECT (SELECT expression FROM tree_catalog_slots() s WHERE s.tree_name = 'shut' AND slot = 'ATTR'),
       (SELECT count(*) FROM (DESCRIBE FROM tree_project('main', 'shut')) WHERE column_name NOT LIKE '\_%' ESCAPE '\');
----
name	1

# ad hoc application of a shape to a bare source
query I
SELECT count(*) FROM tree_apply(tree_shape("order" := 'node_id', level := 'depth'), 'read_parquet(''test/data/app.parquet'')');
----
54

# object names are injective: ('a_b','c') and ('a','b_c') must not compile to the same macro.
# Underscores in the parts are doubled, so a single underscore is only ever the separator.
statement ok
CREATE TABLE tiny(node_id INT, depth INT);

statement ok
INSERT INTO tiny VALUES (0, 0), (1, 1);

statement ok
CALL tree_ddl_create('a_b', 'c', tree_spec(tree_shape("order" := 'node_id', level := 'depth'), source := 'read_parquet(''test/data/app.parquet'')', storage := 'projection'));

statement ok
CALL tree_ddl_create('a', 'b_c', tree_spec(tree_shape("order" := 'node_id', level := 'depth'), source := 'tiny', storage := 'projection'));

query II
SELECT (SELECT count(*) FROM tree_project('a_b', 'c')), (SELECT count(*) FROM tree_project('a', 'b_c'));
----
54	2

# dropping one leaves the other queryable
statement ok
CALL tree_ddl_drop('a', 'b_c');

query I
SELECT count(*) FROM tree_project('a_b', 'c');
----
54

# doubling underscores is not enough on its own: ('a_','c') and ('a','_c') both double to
# a__c. The schema's length goes in front, so decoding reads the number, then exactly that
# many characters, then the separator, then the name.
statement ok
CALL tree_ddl_create('a_', 'c', tree_spec(tree_shape("order" := 'node_id', level := 'depth'), source := 'read_parquet(''test/data/app.parquet'')', storage := 'projection'));

statement ok
CALL tree_ddl_create('a', '_c', tree_spec(tree_shape(key := 'email', parent := 'manager_email'), source := 'read_csv(''test/data/employees.csv'')', storage := 'projection'));

query II
SELECT (SELECT count(*) FROM tree_project('a_', 'c')), (SELECT count(*) FROM tree_project('a', '_c'));
----
54	7

statement ok
CALL tree_ddl_drop('a', '_c');

query I
SELECT count(*) FROM tree_project('a_', 'c');
----
54

# drop removes everything
statement ok
CALL tree_ddl_drop('main', 'app');

query III
SELECT (SELECT count(*) FROM tree_catalog_trees() WHERE tree_name = 'app'), (SELECT count(*) FROM tree_catalog_slots() WHERE tree_name = 'app'), (SELECT count(*) FROM tree_state.partitions WHERE tree_name = 'app');
----
0	0	0

statement error
SELECT * FROM tree_project('main', 'app');
----
proj_4_main_app

# ELEMENT reaches the catalog as an S slot and the projection as a per-row predicate; a
# macro-bound PSEUDO is expanded to its call expression before it is stored
statement ok
CREATE MACRO is_leaf(n) AS n = 0;

statement ok
CALL tree_ddl_create('main', 'elem', tree_spec(tree_shape(root := 'file_path', "order" := 'node_id', level := 'depth',
  semantic := tree_semantic(type := 'type', element := 'regexp_matches(type, ''^[a-z_]'')', pseudo := [{name: 'leaf', macro: 'is_leaf', args: 'descendant_count'}])),
  source := 'read_parquet(''test/data/app.parquet'')'));

query I
SELECT expression FROM tree_catalog_slots() WHERE tree_name = 'elem' AND slot = 'ELEMENT';
----
regexp_matches(type, '^[a-z_]')

query III
SELECT name, kind, body FROM tree_catalog_pseudo_classes() WHERE tree_name = 'elem';
----
leaf	macro	is_leaf(descendant_count)

query I
SELECT count(*) FILTER (WHERE NOT _element) > 0 FROM tree_project('main', 'elem');
----
true

query I
SELECT sql_text FROM tree_catalog.compiled WHERE tree_name = 'elem' AND artifact = 'attribute_columns';
----
["node_id","type","semantic_type","flags","name","qualified_name","signature_type","parameters","modifiers","annotations","file_path","language","start_line","end_line","parent_id","depth","sibling_index","children_count","descendant_count","scope","peek"]

# a prefix-bound PSEUDO binds every catalog macro carrying that prefix, is stored expanded
# with origin = prefix, and is selectable like any other pseudo-class
statement ok
CREATE MACRO sel_x_top(d) AS d = 0;

statement ok
CALL tree_ddl_create('main', 'pfx', tree_spec(tree_shape(root := 'file_path', "order" := 'node_id', level := 'depth',
  semantic := tree_semantic(type := 'type', pseudo := [{prefix: 'sel_x_', args: 'depth'}])),
  source := 'read_parquet(''test/data/app.parquet'')'));

query IIII
SELECT name, kind, body, origin FROM tree_catalog_pseudo_classes() WHERE tree_name = 'pfx';
----
top	macro	sel_x_top(depth)	prefix

query III
FROM tree_match('main', 'pfx', tree_steps([{pseudo: 'top'}]))
SELECT count(*), count(*) FILTER (WHERE depth <> 0), (SELECT count(*) FROM tree_project('main', 'pfx'));
----
1	0	54

# a projection-mode tree records the artifact too (the projection macro is what gets described,
# so one statement serves both storage modes), and an abstract tree records nothing
query II
SELECT (SELECT sql_text FROM tree_catalog.compiled WHERE schema_name = 'a_b' AND tree_name = 'c' AND artifact = 'attribute_columns'),
       (SELECT count(*) FROM tree_catalog.compiled WHERE tree_name = 'ast_shape');
----
["node_id","type","semantic_type","flags","name","qualified_name","signature_type","parameters","modifiers","annotations","file_path","language","start_line","end_line","parent_id","depth","sibling_index","children_count","descendant_count","scope","peek"]	0

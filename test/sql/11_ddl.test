# ---------------------------------------------------------------------------------------
# O conformance at ingest (M3 §3.1)
# ---------------------------------------------------------------------------------------
#
# A declared O column is a FAST PATH, not a second opinion: it must carry the value the
# derivation would have computed. One that does not is a corrupted encoding, and ingest refuses
# it rather than serving wrong subtree ranges, parents, child counts or successors out of it.
#
# The fixture conforms on every O slot -- app.parquet's descendant_count, children_count and
# parent_id, and node_id + descendant_count + 1 as a NEXT, all equal their derived defaults --
# so each record below corrupts exactly ONE row of ONE slot, and the positive record beside it
# is what says the arm is discriminating rather than refusing everything it is given.

statement ok
CREATE TABLE corrupt_size AS SELECT * REPLACE (CASE WHEN node_id = 6 THEN descendant_count + 1 ELSE descendant_count END AS descendant_count) FROM 'test/data/app.parquet';

# the whole spec §3.1 message, pinned once: slot, root, ORDER value, position, both values, and
# the closing clause that says what the refusal is about
statement error
CALL tree_ddl_create('main', 'corrupt_size', tree_spec(tree_shape(root := 'file_path', "order" := 'node_id', level := 'depth', size := 'descendant_count'), source := 'corrupt_size'));
----
O conformance violated in tree main.corrupt_size: SIZE disagrees with its derived default at root {'file_path': app.py}, ORDER 6 (position 6): declared 24, derived 23 (a corrupted encoding, not a fast path)

# PARENT is an O slot when LEVEL is declared beside it: the level basis derives the parent, so a
# declared one is a fast path over that derivation. Node 18's parent is 16; claiming 6 is a lie
# the ASOF derivation catches.
statement ok
CREATE TABLE corrupt_parent AS SELECT * REPLACE (CASE WHEN node_id = 18 THEN 6 ELSE parent_id END AS parent_id) FROM 'test/data/app.parquet';

statement error
CALL tree_ddl_create('main', 'corrupt_parent', tree_spec(tree_shape(root := 'file_path', "order" := 'node_id', level := 'depth', parent := 'parent_id'), source := 'corrupt_parent'));
----
PARENT disagrees with its derived default at root {'file_path': app.py}, ORDER 18 (position 18): declared 6, derived 16

# CHILDREN: the positive first, so the refusal below is evidence about the corruption rather
# than about the arm existing at all.
statement ok
CALL tree_ddl_create('main', 'with_children', tree_spec(tree_shape(root := 'file_path', "order" := 'node_id', level := 'depth', children := 'children_count'), source := 'read_parquet(''test/data/app.parquet'')'));

query II
SELECT count(*), count(*) FILTER (WHERE _children IS DISTINCT FROM children_count) FROM tree_project('main', 'with_children');
----
54	0

statement ok
CREATE TABLE corrupt_children AS SELECT * REPLACE (CASE WHEN node_id = 6 THEN children_count + 1 ELSE children_count END AS children_count) FROM 'test/data/app.parquet';

statement error
CALL tree_ddl_create('main', 'corrupt_children', tree_spec(tree_shape(root := 'file_path', "order" := 'node_id', level := 'depth', children := 'children_count'), source := 'corrupt_children'));
----
CHILDREN disagrees with its derived default at root {'file_path': app.py}, ORDER 6 (position 6): declared 6, derived 5

# NEXT, declared as the structural successor it already is
statement ok
CREATE TABLE with_next AS SELECT *, node_id + descendant_count + 1 AS next_pos FROM 'test/data/app.parquet';

statement ok
CALL tree_ddl_create('main', 'with_next', tree_spec(tree_shape(root := 'file_path', "order" := 'node_id', level := 'depth', next := 'next_pos'), source := 'with_next'));

# it conforms on every row, the LAST one included: node 53 declares 54, which names no row, and
# the projection's COALESCE fallback makes that the structural successor 54 -- equal to the
# derived default, so the tree is accepted.
query II
SELECT count(*), count(*) FILTER (WHERE _next IS DISTINCT FROM _pre + _size + 1) FROM tree_project('main', 'with_next');
----
54	0

statement ok
CREATE TABLE corrupt_next AS SELECT * REPLACE (CASE WHEN node_id = 9 THEN next_pos + 1 ELSE next_pos END AS next_pos) FROM with_next;

statement error
CALL tree_ddl_create('main', 'corrupt_next', tree_spec(tree_shape(root := 'file_path', "order" := 'node_id', level := 'depth', next := 'next_pos'), source := 'corrupt_next'));
----
NEXT disagrees with its derived default at root {'file_path': app.py}, ORDER 9 (position 9): declared 14, derived 13

# The LAST ROW of a root is the case a BOUNDED derived NEXT silently accepts. `__dnext` is the
# structural successor UNCONDITIONALLY -- `_pre + _size + 1`, exactly what the projection
# computes for _next (sql/02_projection.sql) -- so the comparison reaches node 53 like any
# other row. Bounding it by the root's max _pre, and skipping rows where it came out NULL,
# would leave the last row of EVERY root unchecked: here node 53 declares a NEXT of 10, which
# names a real row, and 10 is not 54.
statement ok
CREATE TABLE corrupt_next_last AS SELECT * REPLACE (CASE WHEN node_id = 53 THEN 10 ELSE next_pos END AS next_pos) FROM with_next;

statement error
CALL tree_ddl_create('main', 'corrupt_next_last', tree_spec(tree_shape(root := 'file_path', "order" := 'node_id', level := 'depth', next := 'next_pos'), source := 'corrupt_next_last'));
----
NEXT disagrees with its derived default at root {'file_path': app.py}, ORDER 53 (position 53): declared 10, derived 54

# A declared NEXT that NAMES NO ROW is the case the arm above cannot see. The projection's
# COALESCE makes an unresolvable NEXT the derived default, so `_next IS DISTINCT FROM __dnext` is
# false: the tree was accepted AND tree_check recorded assert_o_next = 'ok' -- a positive verdict
# for a declaration nothing had compared.
#
# "Unresolved" is NOT itself the violation, and that is the whole difficulty. with_next above
# declares next_pos = node_id + descendant_count + 1, and SEVEN of its rows declare 54, which names
# no row -- the root's last row and every ancestor whose subtree ends with it -- and all seven are
# correct. What makes it false is unresolved AND the DERIVATION naming a real row: the declaration
# says nothing follows while the structure says row N does. Where neither names a row they agree,
# and 'ok' is honest.
#
# Position 1, not 0: node 0 declares 54 and derives 54, which is past the root's last _pre (53), so
# node 0 is in the honest residue. Node 1 is the first whose derived successor is a real row.
statement ok
CREATE TABLE next_nowhere AS SELECT * REPLACE (999 AS next_pos) FROM with_next;

statement error
CALL tree_ddl_create('main', 'next_nowhere', tree_spec(tree_shape(root := 'file_path', "order" := 'node_id', level := 'depth', next := 'next_pos'), source := 'next_nowhere'));
----
NEXT disagrees with its derived default at root {'file_path': app.py}, ORDER 1 (position 1): declared names no row (999), derived 6

# A declared NEXT of NULL on a row that DOES have a structural successor is the same violation.
# SIZE and CHILDREN both refuse a NULL override -- plain CAST, no COALESCE, measured -- so a
# declared O column is total, and NEXT accepting one was the inconsistency rather than a per-row
# opt-out. If duckent ever means NULL as "no override on this row", this is the record to change.
statement ok
CREATE TABLE next_null AS SELECT * REPLACE (CASE WHEN node_id = 9 THEN NULL ELSE next_pos END AS next_pos) FROM with_next;

statement error
CALL tree_ddl_create('main', 'next_null', tree_spec(tree_shape(root := 'file_path', "order" := 'node_id', level := 'depth', next := 'next_pos'), source := 'next_null'));
----
ORDER 9 (position 9): declared names no row (NULL), derived 13

# none of the refused creates left a catalog row, a macro or a partition behind
query III
SELECT (SELECT count(*) FROM tree_catalog_trees() WHERE tree_name LIKE 'corrupt%'),
       (SELECT count(*) FROM tree_catalog_slots() WHERE tree_name LIKE 'corrupt%'),
       (SELECT count(*) FROM tree_state.partitions WHERE tree_name LIKE 'corrupt%');
----
0	0	0

# ---------------------------------------------------------------------------
# S-coherence after EXPANSION. The duplicate-name check reads the expanded predicate list
# (03_ddl: create checks (shape).semantic, alter checks sem), so it catches collisions that
# only EXIST after expansion -- a local name against a prefix-derived one, and two prefix
# bindings whose remainders agree. Both were covered by nothing: the only records were two
# literal local names, a collision that exists BEFORE expansion.
#
# Blinding the check to prefix-derived entries passed all 1506 assertions, because the
# duplicate is still refused -- by DuckDB's own `Map keys must be unique.`, which names
# neither the tree nor the predicate. So the failure mode these records guard is not a wrong
# answer; it is an illegible refusal, and the message is what is under test.
# ---------------------------------------------------------------------------
statement ok
CREATE MACRO px_leaf(n) AS n = 0;

statement ok
CREATE MACRO qy_leaf(n) AS n = 1;

# a local name colliding with a prefix-derived one
statement error
CALL tree_ddl_create('main', 'coh1', tree_spec(tree_shape(root := 'file_path', "order" := 'node_id', level := 'depth',
  semantic := tree_semantic(type := 'type', predicate := [{name: 'leaf', body: 'descendant_count = 9'}, {prefix: 'px_', args: 'descendant_count'}])),
  source := 'read_parquet(''test/data/app.parquet'')'));
----
S-coherence: PREDICATE leaf is bound twice

# two prefix bindings whose remainders collide
statement error
CALL tree_ddl_create('main', 'coh2', tree_spec(tree_shape(root := 'file_path', "order" := 'node_id', level := 'depth',
  semantic := tree_semantic(type := 'type', predicate := [{prefix: 'px_', args: 'descendant_count'}, {prefix: 'qy_', args: 'descendant_count'}])),
  source := 'read_parquet(''test/data/app.parquet'')'));
----
S-coherence: PREDICATE leaf is bound twice

# the pre-expansion case names the predicate too, not just "a predicate"
statement error
CALL tree_ddl_create('main', 'coh3', tree_spec(tree_shape(root := 'file_path', "order" := 'node_id', level := 'depth',
  semantic := tree_semantic(type := 'type', predicate := [{name: 'x', body: 'true'}, {name: 'x', body: 'false'}])),
  source := 'read_parquet(''test/data/app.parquet'')'));
----
S-coherence: PREDICATE x is bound twice

# and alter enforces it on the expanded list as well -- the two verbs share the check, so a
# collision create refuses cannot be introduced by altering a tree into it
statement ok
CALL tree_ddl_create('main', 'coh4', tree_spec(tree_shape(root := 'file_path', "order" := 'node_id', level := 'depth',
  semantic := tree_semantic(type := 'type')), source := 'read_parquet(''test/data/app.parquet'')'));

statement error
CALL tree_ddl_alter('main', 'coh4', tree_semantic(type := 'type', predicate := [{name: 'leaf', body: 'descendant_count = 9'}, {prefix: 'px_', args: 'descendant_count'}]));
----
S-coherence: PREDICATE leaf is bound twice

# a prefix binding whose remainders do NOT collide still works: the check refuses ambiguity,
# it does not refuse prefixes
statement ok
CALL tree_ddl_alter('main', 'coh4', tree_semantic(type := 'type', predicate := [{prefix: 'px_', args: 'descendant_count'}]));

query II
SELECT name, origin FROM tree_catalog_predicates() WHERE tree_name = 'coh4';
----
leaf	prefix

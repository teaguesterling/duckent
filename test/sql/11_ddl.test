# ... and the thirteen records above cannot fall behind the list, because the alternation is
# BUILT from tree_canonical_columns() rather than written out. This pins that derivation: a
# hand-written list that drops a name (or a rename that moves one) stops matching here, and a
# canonical column added to the one list is guarded the moment it is added.
query I
SELECT tree_sql_shadow_check('(SELECT 1)', 'tree_ddl_create') LIKE '%' || list_aggregate(list_transform(tree_canonical_columns(), lambda c: substr(c, 2)), 'string_agg', '|') || '%';
----
true


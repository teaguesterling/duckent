# a LIKE child inherits the parent's SEMANTIC group whatever slot the parent declared:
# has_semantic follows the parent's own has_semantic, not just its TYPE
statement ok
CALL tree_ddl_create('main', 'id_shape', tree_spec(tree_shape(root := 'file_path', "order" := 'node_id', level := 'depth', semantic := tree_semantic(key := 'name')), abstract := true));

statement ok
CALL tree_ddl_create('main', 'kid', tree_spec(tree_shape(), "like" := 'id_shape', source := 'read_parquet(''test/data/app.parquet'')'));


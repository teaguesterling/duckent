# a LIKE child inherits the parent's SEMANTIC group whatever slot the parent declared:
# has_semantic follows the parent's own has_semantic, not just its TYPE
statement ok
CALL tree_ddl_create('main', 'id_shape', tree_spec(tree_shape(root := 'file_path', "order" := 'node_id', level := 'depth', semantic := tree_semantic(id := 'name')), abstract := true));

statement ok
CALL tree_ddl_create('main', 'kid', tree_spec(tree_shape(), "like" := 'id_shape', source := 'read_parquet(''test/data/app.parquet'')'));

query I
SELECT has_semantic FROM tree_catalog_trees() WHERE tree_name = 'kid';
----
true

query I
SELECT count(*) FROM tree_match('main', 'kid', tree_steps([{id: 'greet(name).upper'}]));
----
1

# the converse: an S-less parent stays S-less through LIKE. Every tree stores an S/ATTR slot
# ('' for a closed abstract, '*' for an open concrete one), so the merged shape of any LIKE
# child has a non-NULL semantic.attr -- counting ATTR as an S declaration would make every
# child S-ful and silently open the S-clause back door tree_match is supposed to refuse.
statement ok
CALL tree_ddl_create('main', 'sless', tree_spec(tree_shape(root := 'file_path', "order" := 'node_id', level := 'depth'), abstract := true));

statement ok
CALL tree_ddl_create('main', 'kid2', tree_spec(tree_shape(), "like" := 'sless', source := 'read_parquet(''test/data/app.parquet'')'));

query II
SELECT (SELECT has_semantic FROM tree_catalog_trees() WHERE tree_name = 'sless'),
       (SELECT has_semantic FROM tree_catalog_trees() WHERE tree_name = 'kid2');
----
false	false

statement error
SELECT count(*) FROM tree_match('main', 'kid2', tree_steps([{type: 'function_definition'}]));
----
has no SEMANTIC group

# ...and the same back door from the other side, on a tree with no LIKE in sight. A SEMANTIC
# group that declares only ATTR fills no S slot: ATTR names the projected columns, it binds
# nothing structural. Create used to lead its has_semantic expression with
# `(spec).shape.semantic IS NOT NULL` -- counting the PRESENCE of the group rather than what the
# group declared -- so this tree was marked S-ful, and a TYPE step then compiled against TYPE's
# `'node'` default and returned zero rows: a refusal owed, an empty result delivered. Create now
# reads the same per-slot expression tree_ddl_alter reads (13_alter carries the alter-side twin),
# and ATTR is excluded from both for the reason the record above gives.
statement ok
CALL tree_ddl_create('main', 'attronly', tree_spec(tree_shape(root := 'file_path', "order" := 'node_id', level := 'depth',
  semantic := tree_semantic(attr := 'node_id, type')), source := 'read_parquet(''test/data/app.parquet'')'));

query II
SELECT has_semantic, (SELECT sql_text FROM tree_catalog.compiled WHERE tree_name = 'attronly' AND artifact = 'attribute_columns')
FROM tree_catalog_trees() WHERE tree_name = 'attronly';
----
false	[{"name":"node_id","type":"BIGINT"},{"name":"type","type":"VARCHAR"}]

statement error
SELECT count(*) FROM tree_match('main', 'attronly', tree_steps([{type: 'function_definition'}]));
----
has no SEMANTIC group

# the ATTR declaration itself did land: R-only means no S GROUP, not no columns. A WHERE step --
# the thing an S-less tree does have -- still matches, over the narrowed projection.
query I
SELECT count(*) FROM tree_match('main', 'attronly', tree_steps([{"where": 'node_id = 6'}]));
----
1


CHILDREN disagrees with its derived default at root {'file_path': app.py}, ORDER 6 (position 6): declared 6, derived 5

# NEXT, declared as the structural successor it already is
statement ok
CREATE TABLE with_next AS SELECT *, node_id + descendant_count + 1 AS next_pos FROM 'test/data/app.parquet';

statement ok
CALL tree_ddl_create('main', 'with_next', tree_spec(tree_shape(root := 'file_path', "order" := 'node_id', level := 'depth', next := 'next_pos'), source := 'with_next'));

# it conforms on every row, the LAST one included: node 53 declares 54, which names no row, and
# the projection's COALESCE fallback makes that the structural successor 54 -- equal to the
# derived default, so the tree is accepted.
query II
SELECT count(*), count(*) FILTER (WHERE _next IS DISTINCT FROM _pre + _size + 1) FROM tree_project('main', 'with_next');
----
54	0

statement ok
CREATE TABLE corrupt_next AS SELECT * REPLACE (CASE WHEN node_id = 9 THEN next_pos + 1 ELSE next_pos END AS next_pos) FROM with_next;

statement error
CALL tree_ddl_create('main', 'corrupt_next', tree_spec(tree_shape(root := 'file_path', "order" := 'node_id', level := 'depth', next := 'next_pos'), source := 'corrupt_next'));
----
NEXT disagrees with its derived default at root {'file_path': app.py}, ORDER 9 (position 9): declared 14, derived 13

# The LAST ROW of a root is the case a BOUNDED derived NEXT silently accepts. `__dnext` is the
# structural successor UNCONDITIONALLY -- `_pre + _size + 1`, exactly what the projection
# computes for _next (sql/02_projection.sql) -- so the comparison reaches node 53 like any
# other row. Bounding it by the root's max _pre, and skipping rows where it came out NULL,
# would leave the last row of EVERY root unchecked: here node 53 declares a NEXT of 10, which
# names a real row, and 10 is not 54.
statement ok
CREATE TABLE corrupt_next_last AS SELECT * REPLACE (CASE WHEN node_id = 53 THEN 10 ELSE next_pos END AS next_pos) FROM with_next;

statement error
CALL tree_ddl_create('main', 'corrupt_next_last', tree_spec(tree_shape(root := 'file_path', "order" := 'node_id', level := 'depth', next := 'next_pos'), source := 'corrupt_next_last'));
----
NEXT disagrees with its derived default at root {'file_path': app.py}, ORDER 53 (position 53): declared 10, derived 54

# none of the refused creates left a catalog row, a macro or a partition behind
query III
SELECT (SELECT count(*) FROM tree_catalog_trees() WHERE tree_name LIKE 'corrupt%'),
       (SELECT count(*) FROM tree_catalog_slots() WHERE tree_name LIKE 'corrupt%'),
       (SELECT count(*) FROM tree_state.partitions WHERE tree_name LIKE 'corrupt%');
----
0	0	0

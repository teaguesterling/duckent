# object names are injective: ('a_b','c') and ('a','b_c') must not compile to the same macro.
# The SCHEMA's LENGTH is prefixed, not the underscores doubled -- doubling is NOT injective and
# sql/00_types.sql says why (it maps ('a_','c') and ('a','_c') both to a__c). Decoding reads the
# number, then that many characters, then the separator, then the rest: proj_3_a_b_c against
# proj_1_a_b_c here, and proj_2_a__c against proj_1_a__c for the pair doubling collapses.
statement ok
CREATE TABLE tiny(node_id INT, depth INT);

statement ok
INSERT INTO tiny VALUES (0, 0), (1, 1);

statement ok

# ELEMENT reaches the catalog as an S slot and the projection as a per-row predicate; a
# macro-bound PSEUDO is expanded to its call expression before it is stored
statement ok
CREATE MACRO is_leaf(n) AS n = 0;

statement ok
CALL tree_ddl_create('main', 'elem', tree_spec(tree_shape(root := 'file_path', "order" := 'node_id', level := 'depth',
  semantic := tree_semantic(type := 'type', element := 'regexp_matches(type, ''^[a-z_]'')', pseudo := [{name: 'leaf', macro: 'is_leaf', args: 'descendant_count'}])),
  source := 'read_parquet(''test/data/app.parquet'')'));

query I
SELECT expression FROM tree_catalog_slots() WHERE tree_name = 'elem' AND slot = 'ELEMENT';

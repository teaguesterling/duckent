# frozen order (no ORDER declared) is refused while preserve_insertion_order is off, because
# the scan sequence _pre would be taken from is not the source's order (T6)
statement ok
SET preserve_insertion_order = false;

statement error
CALL tree_ddl_create('main', 'bad12', tree_spec(tree_shape(root := 'file_path', level := 'depth'), source := 'read_parquet(''test/data/app.parquet'')'));
----
preserve_insertion_order

statement ok
SET preserve_insertion_order = true;

# the same shape is accepted once the setting is back on
statement ok
CALL tree_ddl_create('main', 'frozen', tree_spec(tree_shape(root := 'file_path', level := 'depth'), source := 'read_parquet(''test/data/app.parquet'')'));

